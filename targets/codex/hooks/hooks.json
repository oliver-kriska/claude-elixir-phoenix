{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(*.ex)",
            "command": "${CODEX_PLUGIN_ROOT}/hooks/scripts/format-elixir.sh",
            "timeout": 30,
            "statusMessage": "Formatting Elixir..."
          },
          {
            "type": "command",
            "if": "Edit(*.exs)",
            "command": "${CODEX_PLUGIN_ROOT}/hooks/scripts/format-elixir.sh",
            "timeout": 30,
            "statusMessage": "Formatting Elixir..."
          },
          {
            "type": "command",
            "if": "Edit(*.ex)",
            "command": "${CODEX_PLUGIN_ROOT}/hooks/scripts/iron-law-verifier.sh",
            "timeout": 15,
            "statusMessage": "Verifying Iron Laws..."
          },
          {
            "type": "command",
            "if": "Edit(*.exs)",
            "command": "${CODEX_PLUGIN_ROOT}/hooks/scripts/iron-law-verifier.sh",
            "timeout": 15,
            "statusMessage": "Verifying Iron Laws..."
          },
          {
            "type": "command",
            "if": "Edit(*.ex)",
            "command": "${CODEX_PLUGIN_ROOT}/hooks/scripts/debug-statement-warning.sh",
            "timeout": 15,
            "statusMessage": "Checking for debug statements..."
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "if": "Write(*.ex)",
            "command": "${CODEX_PLUGIN_ROOT}/hooks/scripts/format-elixir.sh",
            "timeout": 30,
            "statusMessage": "Formatting Elixir..."
          },
          {
            "type": "command",
            "if": "Write(*.exs)",
            "command": "${CODEX_PLUGIN_ROOT}/hooks/scripts/format-elixir.sh",
            "timeout": 30,
            "statusMessage": "Formatting Elixir..."
          },
          {
            "type": "command",
            "if": "Write(*.ex)",
            "command": "${CODEX_PLUGIN_ROOT}/hooks/scripts/iron-law-verifier.sh",
            "timeout": 15,
            "statusMessage": "Verifying Iron Laws..."
          },
          {
            "type": "command",
            "if": "Write(*.exs)",
            "command": "${CODEX_PLUGIN_ROOT}/hooks/scripts/iron-law-verifier.sh",
            "timeout": 15,
            "statusMessage": "Verifying Iron Laws..."
          },
          {
            "type": "command",
            "if": "Write(*.ex)",
            "command": "${CODEX_PLUGIN_ROOT}/hooks/scripts/debug-statement-warning.sh",
            "timeout": 15,
            "statusMessage": "Checking for debug statements..."
          },
          {
            "type": "command",
            "if": "Write(*plan.md)",
            "command": "${CODEX_PLUGIN_ROOT}/hooks/scripts/plan-stop-reminder.sh",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CODEX_PLUGIN_ROOT}/hooks/scripts/security-reminder.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "${CODEX_PLUGIN_ROOT}/hooks/scripts/log-progress.sh",
            "timeout": 15,
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CODEX_PLUGIN_ROOT}/hooks/scripts/block-dangerous-ops.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CODEX_PLUGIN_ROOT}/hooks/scripts/install-codex-agents.sh",
            "timeout": 30,
            "statusMessage": "Installing Codex sub-agents..."
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CODEX_PLUGIN_ROOT}/hooks/scripts/setup-dirs.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "${CODEX_PLUGIN_ROOT}/hooks/scripts/detect-tidewave.sh",
            "timeout": 30,
            "statusMessage": "Detecting Tidewave...",
            "async": true
          }
        ]
      },
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "${CODEX_PLUGIN_ROOT}/hooks/scripts/check-scratchpad.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "${CODEX_PLUGIN_ROOT}/hooks/scripts/check-resume.sh",
            "timeout": 30,
            "statusMessage": "Checking for resumable work..."
          },
          {
            "type": "command",
            "command": "${CODEX_PLUGIN_ROOT}/hooks/scripts/check-branch-freshness.sh",
            "timeout": 30,
            "async": true
          },
          {
            "type": "command",
            "command": "echo 'Elixir/Phoenix plugin loaded \u2014 describe your task and I'\\''ll suggest the right workflow'"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "auto|manual",
        "hooks": [
          {
            "type": "command",
            "command": "${CODEX_PLUGIN_ROOT}/hooks/scripts/precompact-rules.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CODEX_PLUGIN_ROOT}/hooks/scripts/postcompact-verify.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CODEX_PLUGIN_ROOT}/hooks/scripts/check-pending-plans.sh",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "_meta": {
    "dropped_events": [
      "PostToolUseFailure",
      "StopFailure",
      "SubagentStart"
    ]
  }
}
