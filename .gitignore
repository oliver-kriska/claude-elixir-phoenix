# OS
.DS_Store

# rtk filter config (user-local, generated by rtk discover)
.rtk/

# Temporary development files (research/analysis)
/reports/
# `/docs/` was historically a temp dir. Phase 1D of multi-agent-port adds
# `docs/multi-agent/` as a checked-in publication; ignore everything else under /docs/.
/docs/*
!/docs/multi-agent/
/analysis/

# Multi-agent port: only `targets/codex/` is checked in (Codex installs sparsely
# from this repo). Pi and OpenCode targets are generated at release time and
# force-pushed to dedicated mirror repos by `.github/workflows/publish-mirrors.yml`.
# Generate locally via `make port` if needed for inspection.
/targets/pi/
/targets/opencode/

# Node.js (for linting tools)
node_modules/

# Git worktrees
.worktrees/

# Claude Code local files (user-specific)
# Ignore contents but track agents and commands
!.claude/
.claude/*
!.claude/agents/
!.claude/commands/
!.claude/skills/
!.claude/research/
!.claude/cc-changelog/
# Fetched CC changelog (193KB, re-downloadable)
.claude/cc-changelog/changelog-cache.md
.claude/skills/analyze-sessions/references/session-index.json
# Runtime artifacts (docs-cache, reports, summaries)
.claude/docs-check/
scratchpad/

# Python bytecode (any subdirectory)
__pycache__/
*.pyc
*.pyo

# Tournament runtime artifacts
/lab/tournament/results/

# Scribe / iMessage ingestion scratch (regenerated on cron)
/output/
/raw/
/scripts/imessage-state.json
/.claude/research
